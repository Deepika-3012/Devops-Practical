pipeline {
    agent any

    stages {

        stage('Git Checkout') {
            steps {
                echo 'Checking out source code'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the project'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the project'
            }
        }
    }
}